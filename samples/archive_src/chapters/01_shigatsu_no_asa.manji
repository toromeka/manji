   "wait": 2950,
   "dur": 2550,
   "size": 18
  },
  {
   "type": "say",
   "speaker": "center",
   "text": "「行ってきます、義母さん」",
   "pos": "toro",
   "wait": 2300,
   "dur": 2250,
   "size": 16
  },
  {
   "type": "narr",
