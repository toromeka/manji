   "pos": "yuiNext",
   "wait": 5500,
   "dur": 2250,
   "size": 12
  },
  {
   "type": "say",
   "speaker": "center",
   "text": "「ん？」",
   "pos": "toro",
   "wait": 2300,
   "dur": 1600,
   "size": 16
  },
  {
   "type": "say",
   "speaker": "right",
   "text": "「……なんでもない」",
   "pos": "yuiNext",
   "wait": 2950,
   "dur": 2250,
   "size": 12
  },
  {
   "type": "narr",
   "text": "二人で階段を下りると、美智子が玄関で靴を揃えていた。",
   "wait": 2800
  },
  {
   "type": "say",
   "speaker": "left",
   "text": "「行ってらっしゃい。気をつけてね」",
