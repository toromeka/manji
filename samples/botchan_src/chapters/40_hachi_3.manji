  {
   "type": "caption",
   "text": "八（その三）",
   "dur": 3200,
   "wait": 300
  },
  {
   "type": "narr",
   "text": "帰ってうんと考え込んだ。",
   "wait": 600
  },
  {
   "type": "narr",
   "text": "世間には随分気の知れない男が居る。",
   "wait": 1880
  },
  {
   "type": "narr",
   "text": "家屋敷はもちろん、勤める学校に不足のない故郷がいやになったからと云って、知らぬ他国へ苦労を求めに出る。",
   "wait": 2210
  },
  {
   "type": "narr",
   "text": "それも花の都の電車が通ってる所なら、まだしもだが、日向の延岡とは何の事だ。",
   "wait": 4420
  },
  {
   "type": "narr",
   "text": "おれは船つきのいいここへ来てさえ、一ヶ月立たないうちにもう帰りたくなった。",
   "wait": 3510
  },
  {
   "type": "narr",
   "text": "延岡と云えば山の中も山の中も大変な山の中だ。",
   "wait": 3510
  },
  {
   "type": "narr",
   "text": "赤シャツの云うところによると船から上がって、一日馬車へ乗って、宮崎へ行って、",
   "wait": 2530
  },
  {
   "type": "narr",
   "text": "宮崎からまた一日車へ乗らなくっては着けないそうだ。",
   "wait": 3570
  },
  {
   "type": "narr",
   "text": "名前を聞いてさえ、開けた所とは思えない。",
   "wait": 2730
  },
  {
   "type": "narr",
   "text": "猿と人とが半々に住んでるような気がする。",
   "wait": 2400
  },
  {
   "type": "narr",
   "text": "いかに聖人のうらなり君だって、好んで猿の相手になりたくもないだろうに、何という物数奇だ。",
   "wait": 2400
  },
  {
   "type": "se",
   "text": "とんとん",
   "dur": 1600,
   "pos": "seR",
   "se": "steps",
   "wait": 300
  },
  {
   "type": "narr",
   "text": "ところへあいかわらず婆さんが夕食を運んで出る。",
   "wait": 3960
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "今日もまた芋ですかい",
   "dur": 2800,
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "と聞いてみたら、",
   "wait": 0
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "いえ今日はお豆腐ぞなもし",
   "dur": 3060,
   "wait": 1620
  },
  {
   "type": "narr",
   "text": "と云った。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "どっちにしたって似たものだ。",
   "wait": 1430
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「お婆さん古賀さんは日向へ行くそうですね」",
   "dur": 4230,
   "wait": 2010
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「ほん当にお気の毒じゃな、もし」",
   "dur": 3580,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「お気の毒だって、好んで行くんなら仕方がないですね」",
   "dur": 4880,
   "wait": 3120
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「好んで行くて、誰がぞなもし」",
   "dur": 3450,
   "wait": 4320
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「誰がぞなもしって、当人がさ。",
   "dur": 3450,
   "wait": 3000
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "古賀先生が物数奇に行くんじゃありませんか」",
   "dur": 4230,
   "wait": 3000
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「そりゃあなた、大違いの勘五郎ぞなもし」",
   "dur": 4100,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「勘五郎かね。",
   "dur": 2410,
   "wait": 3600
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "だって今赤シャツがそう云いましたぜ。",
   "dur": 3840,
   "wait": 2040
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "それが勘五郎なら赤シャツは嘘つきの法螺右衛門だ」",
   "dur": 4620,
   "wait": 3360
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「教頭さんが、そうお云いるのはもっともじゃが、古賀さんのお往きともないのももっともぞなもし」",
   "dur": 7000,
   "wait": 4080
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「そんなら両方もっともなんですね。",
   "dur": 3710,
   "wait": 6720
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "お婆さんは公平でいい。",
   "dur": 2930,
   "wait": 3240
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "一体どういう訳なんですい」",
   "dur": 3190,
   "wait": 2520
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「今朝古賀のお母さんが見えて、だんだん訳をお話したがなもし」",
   "dur": 5400,
   "wait": 2760
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「どんな訳をお話したんです」",
   "dur": 3320,
   "wait": 4800
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「あそこもお父さんがお亡くなりてから、あたし達が思うほど暮し向が豊かになうてお困りじゃけれ、お母さんが校長さんにお頼みて、",
   "dur": 7000,
   "wait": 2880
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "もう四年も勤めているものじゃけれ、どうぞ毎月頂くものを、今少しふやしておくれんかてて、あなた」",
   "dur": 7000,
   "wait": 8520
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「なるほど」",
   "dur": 2280,
   "wait": 6840
  },
  {
   "type": "fx",
   "fx": "tint",
   "preset": "cold",
   "amount": 0.35,
   "dur": 1200,
   "wait": 1920
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「校長さんが、ようまあ考えてみとこうとお云いたげな。",
   "dur": 4880,
   "wait": 1920
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "それでお母さんも安心して、今に増給のご沙汰があろぞ、今月か来月かと首を長くして待っておいでたところへ、",
   "dur": 7000,
   "wait": 4320
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "校長さんがちょっと来てくれと古賀さんにお云いるけれ、行ってみると、気の毒だが学校は金が足りんけれ、月給を上げる訳にゆかん。",
   "dur": 7000,
   "wait": 7320
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "しかし延岡になら空いた口があって、そっちなら毎月五円余分にとれるから、お望み通りでよかろうと思うて、",
   "dur": 7000,
   "wait": 8520
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "その手続きにしたから行くがええと云われたげな。",
   "dur": 4490,
   "wait": 7200
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "――」",
   "dur": 2000,
   "wait": 3960
  },
  {
   "type": "fx",
   "fx": "tint",
   "preset": "none",
   "dur": 800,
   "wait": 1800
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「じゃ相談じゃない、命令じゃありませんか」",
   "dur": 4230,
   "wait": 1800
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「さよよ。",
   "dur": 2150,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "古賀さんはよそへ行って月給が増すより、元のままでもええから、ここに居りたい。",
   "dur": 6440,
   "wait": 1800
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "屋敷もあるし、母もあるからとお頼みたけれども、もうそう極めたあとで、",
   "dur": 5920,
   "wait": 5760
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "古賀さんの代りは出来ているけれ仕方がないと校長がお云いたげな」",
   "dur": 5530,
   "wait": 5280
  },
  {
   "type": "fx",
   "fx": "bgm",
   "preset": "tense",
   "wait": 4920
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「へん人を馬鹿にしてら、面白くもない。",
   "dur": 3970,
   "wait": 4920
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "じゃ古賀さんは行く気はないんですね。",
   "dur": 3840,
   "wait": 3480
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "どうれで変だと思った。",
   "dur": 2930,
   "wait": 3360
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "五円ぐらい上がったって、あんな山の中へ猿のお相手をしに行く唐変木はまずないからね」",
   "dur": 6830,
   "wait": 2520
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「唐変木て、先生なんぞなもし」",
   "dur": 3450,
   "wait": 6120
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「何でもいいでさあ、――全く赤シャツの作略だね。",
   "dur": 4620,
   "wait": 3000
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "よくない仕打だ。",
   "dur": 2540,
   "wait": 4080
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "まるで欺撃ですね。",
   "dur": 2670,
   "wait": 2160
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "それでおれの月給を上げるなんて、不都合な事があるものか。",
   "dur": 5140,
   "wait": 2280
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "上げてやるったって、誰が上がってやるものか」",
   "dur": 4360,
   "wait": 4560
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「先生は月給がお上りるのかなもし」",
   "dur": 3710,
   "wait": 3840
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「上げてやるって云うから、断わろうと思うんです」",
   "dur": 4620,
   "wait": 3240
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「何で、お断わりるのぞなもし」",
   "dur": 3450,
   "wait": 4080
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「何でもお断わりだ。",
   "dur": 2800,
   "wait": 3000
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "お婆さん、あの赤シャツは馬鹿ですぜ。",
   "dur": 3840,
   "wait": 2400
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "卑怯でさあ」",
   "dur": 2280,
   "wait": 3360
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "「卑怯でもあんた、月給を上げておくれたら、大人しく頂いておく方が得ぞなもし。",
   "dur": 6440,
   "wait": 1920
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "若いうちはよく腹の立つものじゃが、年をとってから考えると、も少しの我慢じゃあったのに惜しい事をした。",
   "dur": 7000,
   "wait": 5760
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "腹立てたためにこないな損をしたと悔むのが当り前じゃけれ、お婆の言う事をきいて、赤シャツさんが月給をあげてやろとお言いたら、",
   "dur": 7000,
   "wait": 7200
  },
  {
   "type": "say",
   "who": "婆さん",
   "text": "難有うと受けておおきなさいや」",
   "dur": 3450,
   "wait": 8520
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「年寄の癖に余計な世話を焼かなくってもいい。",
   "dur": 4360,
   "wait": 3000
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "おれの月給は上がろうと下がろうとおれの月給だ」",
   "dur": 4490,
   "wait": 3840
  },
  {
   "type": "fx",
   "fx": "fadeout",
   "dur": 2000,
   "wait": 3960
  },
