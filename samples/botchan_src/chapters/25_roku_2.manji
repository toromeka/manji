   "dur": 3200,
   "wait": 300
  },
  {
   "type": "narr",
   "text": "おれはここまで考えたら、眠くなったからぐうぐう寝てしまった。",
   "wait": 600
  },
  {
   "type": "fx",
   "fx": "fadeout",
   "dur": 900,
   "wait": 3050
  },
  {
   "type": "fx",
