  {
   "type": "fx",
   "fx": "fadein",
   "dur": 1500,
   "wait": 200
  },
  {
   "type": "caption",
   "text": "三（その四）",
   "dur": 3200,
   "wait": 300
  },
  {
   "type": "narr",
   "text": "天麩羅蕎麦もうちへ帰って、一晩寝たらそんなに肝癪に障らなくなった。",
   "wait": 600
  },
  {
   "type": "narr",
   "text": "学校へ出てみると、生徒も出ている。",
   "wait": 3240
  },
  {
   "type": "narr",
   "text": "何だか訳が分らない。",
   "wait": 2200
  },
  {
   "type": "narr",
   "text": "それから三日ばかりは無事であったが、",
   "wait": 1750
  },
  {
   "type": "narr",
   "text": "四日目の晩に住田と云う所へ行って団子を食った。",
   "wait": 2270
  },
  {
   "type": "narr",
   "text": "この住田と云う所は温泉のある町で",
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "城下から汽車だと十分ばかり、歩いて三十分で行かれる、",
   "wait": 2140
  },
  {
   "type": "narr",
   "text": "料理屋も温泉宿も、公園もある上に遊廓がある。",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "おれのはいった団子屋は遊廓の入口にあって、",
   "wait": 2530
  },
  {
   "type": "narr",
   "text": "大変うまいという評判だから、",
   "wait": 2460
  },
  {
   "type": "narr",
   "text": "温泉に行った帰りがけにちょっと食ってみた。",
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "今度は生徒にも逢わなかったから、誰も知るまいと思って、",
   "wait": 2460
  },
  {
   "type": "narr",
   "text": "翌日学校へ行って、一時間目の教場へはいると団子二皿七銭と書いてある。",
   "wait": 2860
  },
  {
   "type": "narr",
   "text": "実際おれは二皿食って七銭払った。",
   "wait": 3310
  },
  {
   "type": "narr",
   "text": "どうも厄介な奴等だ。",
   "wait": 2140
  },
  {
   "type": "narr",
   "text": "二時間目にもきっと何かあると思うと遊廓の団子旨い旨いと書いてある。",
   "wait": 1750
  },
  {
   "type": "narr",
   "text": "あきれ返った奴等だ。",
   "wait": 3240
  },
  {
   "type": "narr",
   "text": "団子がそれで済んだと思ったら今度は赤手拭と云うのが評判になった。",
   "wait": 1750
  },
  {
   "type": "narr",
   "text": "何の事だと思ったら、つまらない来歴だ。",
   "wait": 3180
  },
  {
   "type": "narr",
   "text": "おれはここへ来てから、毎日住田の温泉へ行く事に極めている。",
   "wait": 2340
  },
  {
   "type": "narr",
   "text": "ほかの所は何を見ても東京の足元にも及ばないが",
   "wait": 2980
  },
  {
   "type": "narr",
   "text": "温泉だけは立派なものだ。",
   "wait": 2530
  },
  {
   "type": "narr",
   "text": "せっかく来た者だから毎日はいってやろうという気で、",
   "wait": 1880
  },
  {
   "type": "narr",
   "text": "晩飯前に運動かたがた出掛る。",
   "wait": 2720
  },
  {
   "type": "narr",
   "text": "ところが行くときは必ず西洋手拭の大きな奴をぶら下げて行く。",
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "この手拭が湯に染った上へ、赤い縞が流れ出したので",
   "wait": 2980
  },
  {
   "type": "narr",
   "text": "ちょっと見ると紅色に見える。",
   "wait": 2660
  },
  {
   "type": "narr",
   "text": "おれはこの手拭を行きも帰りも、汽車に乗ってもあるいても、常にぶら下げている。",
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "それで生徒がおれの事を赤手拭赤手拭と云うんだそうだ。",
   "wait": 3570
  },
  {
   "type": "narr",
   "text": "どうも狭い土地に住んでるとうるさいものだ。",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "まだある。",
   "wait": 2460
  },
  {
   "type": "narr",
   "text": "温泉は三階の新築で上等は浴衣をかして、流しをつけて八銭で済む。",
   "wait": 1420
  },
  {
   "type": "narr",
   "text": "その上に女が天目へ茶を載せて出す。",
   "wait": 3120
  },
  {
   "type": "narr",
   "text": "おれはいつでも上等へはいった。",
   "wait": 2200
  },
  {
   "type": "narr",
   "text": "すると四十円の月給で毎日上等へはいるのは贅沢だと云い出した。",
   "wait": 2080
  },
  {
   "type": "narr",
   "text": "余計なお世話だ。",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "まだある。",
   "wait": 1620
  },
  {
   "type": "narr",
   "text": "湯壺は花崗石を畳み上げて、十五畳敷ぐらいの広さに仕切ってある。",
   "wait": 1420
  },
  {
   "type": "narr",
   "text": "大抵は十三四人漬ってるがたまには誰も居ない事がある。",
   "wait": 3120
  },
  {
   "type": "narr",
   "text": "深さは立って乳の辺まであるから、運動のために、",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "湯の中を泳ぐのはなかなか愉快だ。",
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "おれは人の居ないのを見済しては十五畳の湯壺を泳ぎ巡って喜んでいた。",
   "wait": 2140
  },
  {
   "type": "narr",
   "text": "ところがある日三階から威勢よく下りて",
   "wait": 3240
  },
  {
   "type": "narr",
   "text": "今日も泳げるかなとざくろ口を覗いてみると、",
   "wait": 2270
  },
  {
   "type": "narr",
   "text": "大きな札へ黒々と湯の中で泳ぐべからずとかいて貼りつけてある。",
   "wait": 2460
  },
  {
   "type": "narr",
   "text": "湯の中で泳ぐものは、あまりあるまいから、",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "この貼札はおれのために特別に新調したのかも知れない。",
   "wait": 2400
  },
  {
   "type": "narr",
   "text": "おれはそれから泳ぐのは断念した。",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "泳ぐのは断念したが、学校へ出てみると、",
   "wait": 2140
  },
  {
   "type": "narr",
   "text": "例の通り黒板に湯の中で泳ぐべからずと書いてあるには驚ろいた。",
   "wait": 2340
  },
  {
   "type": "narr",
   "text": "何だか生徒全体がおれ一人を探偵しているように思われた。",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "くさくさした。",
   "wait": 2860
  },
  {
   "type": "narr",
   "text": "生徒が何を云ったって、やろうと思った事をやめるようなおれではないが、",
   "wait": 1560
  },
  {
   "type": "narr",
   "text": "何でこんな狭苦しい鼻の先がつかえるような所へ来たのかと思うと情なくなった。",
   "wait": 3310
  },
  {
   "type": "narr",
   "text": "それでうちへ帰ると相変らず骨董責である。",
   "wait": 3500
  },
  {
   "type": "fx",
   "fx": "fadeout",
   "dur": 2000,
   "wait": 2400
  },
  {
   "type": "fx",
   "fx": "bgm",
   "preset": "none",
   "wait": 2000
  }
 ]
}