   "wait": 100
  },
  {
   "type": "se",
   "text": "からんころん",
   "dur": 1800,
   "pos": "seL",
   "se": "geta-out",
   "wait": 200
  },
  {
   "type": "narr",
   "text": "小倉の袴をつけてまた出掛けた。",
   "wait": 3120
  },
  {
   "type": "narr",
   "text": "大きな玄関へ突っ立って",
   "wait": 2080
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "頼む",
   "dur": 2000,
   "wait": 1820
  },
  {
   "type": "narr",
   "text": "と云うと、また例の弟が取次に出て来た。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "おれの顔を見てまた来たかという眼付をした。",
   "wait": 2340
  },
  {
   "type": "narr",
   "text": "用があれば二度だって三度だって来る。",
   "wait": 2470
  },
  {
   "type": "narr",
   "text": "よる夜なかだって叩き起さないとは限らない。",
   "wait": 2270
  },
  {
   "type": "narr",
   "text": "教頭の所へご機嫌伺いにくるようなおれと見損ってるか。",
   "wait": 2470
  },
  {
   "type": "narr",
   "text": "これでも月給が入らないから返しに来んだ。",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "すると弟が",
   "wait": 2400
  },
  {
   "type": "say",
   "who": "赤シャツの弟",
   "text": "今来客中だ",
   "dur": 2150,
   "wait": 1430
  },
  {
   "type": "narr",
   "text": "と云うから、",
   "wait": 0
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "玄関でいいからちょっとお目にかかりたい",
   "dur": 3970,
   "wait": 1490
  },
  {
   "type": "narr",
   "text": "と云ったら奥へ引き込んだ。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "足元を見ると、畳付きの薄っぺらな、のめりの駒下駄がある。",
   "wait": 1950
  },
  {
   "type": "narr",
   "text": "奥で",
   "wait": 2920
  },
  {
   "type": "say",
   "who": "野だいこ",
   "text": "もう万歳ですよ",
   "dur": 2410,
   "wait": 1230
  },
  {
   "type": "narr",
   "text": "と云う声が聞える。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "お客とは野だだなと気がついた。",
   "wait": 1690
  },
  {
   "type": "narr",
   "text": "野だでなくては、あんな黄色い声を出して、こんな芸人じみた下駄を穿くものはない。",
   "wait": 2080
  },
  {
   "type": "narr",
   "text": "しばらくすると、赤シャツがランプを持って玄関まで出て来て、",
   "wait": 3640
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "まあ上がりたまえ、外の人じゃない吉川君だ、",
   "dur": 4230,
   "wait": 2990
  },
  {
   "type": "narr",
   "text": "と云うから、",
   "wait": 0
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "いえここでたくさんです。",
   "dur": 3060,
   "wait": 1490
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "ちょっと話せばいいんです、",
   "dur": 3190,
   "wait": 2640
  },
  {
   "type": "narr",
   "text": "と云って、赤シャツの顔を見ると金時のようだ。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "野だ公と一杯飲んでると見える。",
   "wait": 2530
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「さっき僕の月給を上げてやるというお話でしたが、少し考えが変ったから断わりに来たんです」",
   "dur": 7000,
   "wait": 2080
  },
  {
   "type": "narr",
   "text": "赤シャツはランプを前へ出して、奥の方からおれの顔を眺めたが、とっさの場合返事をしかねて茫然としている。",
   "wait": 6480
  },
  {
   "type": "narr",
   "text": "増給を断わる奴が世の中にたった一人飛び出して来たのを不審に思ったのか、断わるにしても、今帰ったばかりで、",
   "wait": 4420
  },
  {
   "type": "narr",
   "text": "すぐ出直してこなくってもよさそうなものだと、呆れ返ったのか、または双方合併したのか、妙な口をして突っ立ったままである。",
   "wait": 4480
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「あの時承知したのは、古賀君が自分の希望で転任するという話でしたからで……」",
   "dur": 6440,
   "wait": 4940
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "「古賀君は全く自分の希望で半ば転任するんです」",
   "dur": 4490,
   "wait": 5760
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「そうじゃないんです、ここに居たいんです。",
   "dur": 4230,
   "wait": 3960
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "元の月給でもいいから、郷里に居たいのです」",
   "dur": 4230,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "「君は古賀君から、そう聞いたのですか」",
   "dur": 3970,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「そりゃ当人から、聞いたんじゃありません」",
   "dur": 4230,
   "wait": 3480
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "「じゃ誰からお聞きです」",
   "dur": 3060,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「僕の下宿の婆さんが、古賀さんのおっ母さんから聞いたのを今日僕に話したのです」",
   "dur": 6570,
   "wait": 2640
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "「じゃ、下宿の婆さんがそう云ったのですね」",
   "dur": 4230,
   "wait": 5880
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「まあそうです」",
   "dur": 2540,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "「それは失礼ながら少し違うでしょう。",
   "dur": 3840,
   "wait": 2160
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "あなたのおっしゃる通りだと、下宿屋の婆さんの云う事は信ずるが、教頭の云う事は信じないと云うように聞えるが、",
   "dur": 7000,
