  {
   "type": "caption",
   "text": "六（その三）",
   "dur": 3200,
   "wait": 300
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「冗談じゃない本当だ。おれは君に氷水を奢られる因縁がないから、出すんだ。取らない法があるか」",
   "dur": 7000,
   "wait": 600
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「そんなに一銭五厘が気になるなら取ってもいいが、なぜ思い出したように、今時分返すんだ」",
   "dur": 7000,
   "wait": 6720
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「今時分でも、いつ時分でも、返すんだ。奢られるのが、いやだから返すんだ」",
   "dur": 6180,
   "wait": 6360
  },
  {
   "type": "narr",
   "text": "山嵐は冷然とおれの顔を見てふんと云った。",
   "wait": 5520
  },
  {
   "type": "narr",
   "text": "赤シャツの依頼がなければ、ここで山嵐の卑劣をあばいて大喧嘩をしてやるんだが、口外しないと受け合ったんだから動きがとれない。",
   "wait": 2400
  },
  {
   "type": "narr",
   "text": "人がこんなに真赤になってるのにふんという理窟があるものか。",
   "wait": 5060
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「氷水の代は受け取るから、下宿は出てくれ」",
   "dur": 4230,
   "wait": 2980
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「一銭五厘受け取ればそれでいい。下宿を出ようが出まいがおれの勝手だ」",
   "dur": 5920,
   "wait": 3720
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「ところが勝手でない、昨日、あすこの亭主が来て君に出てもらいたいと云うから、その訳を聞いたら亭主の云うのはもっともだ。",
   "dur": 7000,
   "wait": 5280
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "それでももう一応たしかめるつもりで今朝あすこへ寄って詳しい話を聞いてきたんだ」",
   "dur": 6570,
   "wait": 8280
  },
  {
   "type": "narr",
   "text": "おれには山嵐の云う事が何の意味だか分らない。",
   "wait": 5880
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「亭主が君に何を話したんだか、おれが知ってるもんか。",
   "dur": 4880,
   "wait": 2530
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "そう自分だけで極めたって仕様があるか。",
   "dur": 3970,
   "wait": 4320
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "訳があるなら、訳を話すが順だ。",
   "dur": 3450,
   "wait": 3480
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "てんから亭主の云う方がもっともだなんて失敬千万な事を云うな」",
   "dur": 5400,
   "wait": 3000
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「うん、そんなら云ってやろう。君は乱暴であの下宿で持て余まされているんだ。",
   "dur": 6310,
   "wait": 4800
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "いくら下宿の女房だって、下女たあ違うぜ。足を出して拭かせるなんて、威張り過ぎるさ」",
   "dur": 6830,
   "wait": 5640
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「おれが、いつ下宿の女房に足を拭かせた」",
   "dur": 4100,
   "eff": "shake",
   "wait": 6120
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「拭かせたかどうだか知らないが、とにかく向うじゃ、君に困ってるんだ。",
   "dur": 5920,
   "wait": 3600
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "下宿料の十円や十五円は懸物を一幅売りゃ、すぐ浮いてくるって云ってたぜ」",
   "dur": 6050,
   "wait": 5280
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「利いた風な事をぬかす野郎だ。そんなら、なぜ置いた」",
   "dur": 4880,
   "wait": 5400
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「なぜ置いたか、僕は知らん、置くことは置いたんだが、いやになったんだから、出ろと云うんだろう。",
   "dur": 7000,
   "wait": 4320
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "君出てやれ」",
   "dur": 2280,
   "wait": 6840
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「当り前だ。居てくれと手を合せたって、居るものか。",
   "dur": 4750,
   "wait": 1920
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "一体そんな云い懸りを云うような所へ周旋する君からしてが不埒だ」",
   "dur": 5530,
   "wait": 4200
  },
  {
   "type": "say",
   "who": "山嵐",
   "text": "「おれが不埒か、君が大人しくないんだか、どっちかだろう」",
   "dur": 5140,
   "wait": 4920
  },
  {
   "type": "narr",
   "text": "山嵐もおれに劣らぬ肝癪持ちだから、負け嫌いな大きな声を出す。",
   "wait": 4560
  },
  {
   "type": "fx",
   "fx": "shake",
   "power": 6,
   "dur": 500,
   "wait": 0
  },
  {
   "type": "narr",
   "text": "控所に居た連中は何事が始まったかと思って、みんな、おれと山嵐の方を見て、顋を長くしてぼんやりしている。",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "おれは、別に恥ずかしい事をした覚えはないんだから、立ち上がりながら、部屋中一通り見巡わしてやった。",
   "wait": 4420
  },
  {
   "type": "narr",
   "text": "みんなが驚ろいてるなかに野だだけは面白そうに笑っていた。",
   "wait": 4280
  },
  {
   "type": "narr",
   "text": "おれの大きな眼が、貴様も喧嘩をするつもりかと云う権幕で、野だの干瓢づらを射貫いた時に、",
   "wait": 2920
  },
  {
   "type": "narr",
   "text": "野だは突然真面目な顔をして、大いにつつしんだ。",
   "wait": 3900
  },
  {
   "type": "narr",
   "text": "少し怖わかったと見える。",
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "そのうち喇叭が鳴る。",
   "wait": 1880
  },
  {
   "type": "narr",
   "text": "山嵐もおれも喧嘩を中止して教場へ出た。",
   "wait": 1750
  },
  {
   "type": "fx",
   "fx": "mosaic",
   "size": 18,
   "dur": 600,
   "wait": 2340
  },
  {
   "type": "fx",
   "fx": "mosaic",
   "size": 1,
   "dur": 600,
   "wait": 650
  },
  {
   "type": "narr",
   "text": "午後は、先夜おれに対して無礼を働いた寄宿生の処分法についての会議だ。",
   "wait": 300
  },
  {
   "type": "narr",
   "text": "会議というものは生れて始めてだからとんと容子が分らないが、",
   "wait": 3310
  },
  {
   "type": "narr",
   "text": "職員が寄って、たかって自分勝手な説をたてて、それを校長が好い加減に纏めるのだろう。",
   "wait": 2980
  },
  {
   "type": "narr",
   "text": "纏めるというのは黒白の決しかねる事柄について云うべき言葉だ。",
   "wait": 3760
  },
  {
   "type": "narr",
   "text": "この場合のような、誰が見たって、不都合としか思われない事件に会議をするのは暇潰しだ。",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "誰が何と解釈したって異説の出ようはずがない。",
   "wait": 3830
  },
  {
   "type": "narr",
   "text": "こんな明白なのは即座に校長が処分してしまえばいいに。",
   "wait": 2530
  },
  {
   "type": "narr",
   "text": "随分決断のない事だ。",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "校長ってものが、これならば、何の事はない、煮え切らない愚図の異名だ。",
   "wait": 1750
  },
