  {
   "type": "caption",
   "text": "五（その一）",
   "dur": 3200,
   "wait": 300
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "君釣りに行きませんか",
   "dur": 2800,
   "wait": 600
  },
  {
   "type": "narr",
   "text": "と赤シャツがおれに聞いた。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "赤シャツは気味の悪るいように優しい声を出す男である。",
   "wait": 1940
  },
  {
   "type": "narr",
   "text": "まるで男だか女だか分りゃしない。男なら男らしい声を出すもんだ。",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "ことに大学卒業生じゃないか。",
   "wait": 3120
  },
  {
   "type": "narr",
   "text": "物理学校でさえおれくらいな声が出るのに、文学士がこれじゃ見っともない。",
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "おれは",
   "wait": 3380
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "そうですなあ",
   "dur": 2280,
   "wait": 1300
  },
  {
   "type": "narr",
   "text": "と少し進まない返事をしたら、",
   "wait": 0
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "君釣をした事がありますか",
   "dur": 3060,
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "と失敬な事を聞く。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "あんまりないが、子供の時、小梅の釣堀で鮒を三匹釣った事がある。",
   "wait": 1680
  },
  {
   "type": "narr",
   "text": "それから神楽坂の毘沙門の縁日で八寸ばかりの鯉を針で引っかけて、",
   "wait": 3120
  },
  {
   "type": "narr",
   "text": "しめたと思ったら、ぽちゃりと落としてしまったがこれは今考えても惜しい",
   "wait": 3120
  },
  {
   "type": "narr",
   "text": "と云ったら、赤シャツは顋を前の方へ突き出してホホホホと笑った。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "何もそう気取って笑わなくっても、よさそうな者だ。",
   "wait": 3120
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "「それじゃ、まだ釣りの味は分らんですな。お望みならちと伝授しましょう」",
   "dur": 6050,
   "wait": 2660
  },
  {
   "type": "narr",
   "text": "とすこぶる得意である。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "だれがご伝授をうけるものか。",
   "wait": 1820
  },
  {
   "type": "narr",
   "text": "一体釣や猟をする連中はみんな不人情な人間ばかりだ。",
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "不人情でなくって、殺生をして喜ぶ訳がない。",
   "wait": 2720
  },
  {
   "type": "narr",
   "text": "魚だって、鳥だって殺されるより生きてる方が楽に極まってる。",
   "wait": 2460
  },
  {
   "type": "narr",
   "text": "釣や猟をしなくっちゃ活計がたたないなら格別だが、",
   "wait": 2980
  },
  {
   "type": "narr",
   "text": "何不足なく暮している上に、生き物を殺さなくっちゃ寝られないなんて贅沢な話だ。",
   "wait": 2660
  },
  {
   "type": "narr",
   "text": "こう思ったが向うは文学士だけに口が達者だから、議論じゃ叶わないと思って、だまってた。",
   "wait": 3570
  },
  {
   "type": "narr",
   "text": "すると先生このおれを降参させたと疳違いして、",
   "wait": 3830
  },
  {
   "type": "say",
   "who": "赤シャツ",
   "text": "早速伝授しましょう。おひまなら、今日どうです、いっしょに行っちゃ。吉川君と二人ぎりじゃ、淋しいから、来たまえ",
   "dur": 7000,
   "wait": 2530
  },
  {
   "type": "narr",
   "text": "としきりに勧める。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "吉川君というのは画学の教師で例の野だいこの事だ。",
   "wait": 1680
  },
  {
   "type": "narr",
   "text": "この野だは、どういう了見だか、赤シャツのうちへ朝夕出入して、どこへでも随行して行く。",
   "wait": 2660
  },
  {
   "type": "narr",
   "text": "まるで同輩じゃない。主従みたようだ。",
   "wait": 3830
  },
  {
   "type": "narr",
   "text": "赤シャツの行く所なら、野だは必ず行くに極っているんだから、今さら驚ろきもしないが、",
   "wait": 2270
  },
  {
   "type": "narr",
   "text": "二人で行けば済むところを、なんで無愛想のおれへ口を掛けたんだろう。",
   "wait": 3760
  },
  {
   "type": "narr",
   "text": "大方高慢ちきな釣道楽で、自分の釣るところをおれに見せびらかすつもりかなんかで誘ったに違いない。",
   "wait": 3240
  },
  {
   "type": "narr",
   "text": "そんな事で見せびらかされるおれじゃない。",
   "wait": 4160
  },
  {
   "type": "narr",
   "text": "鮪の二匹や三匹釣ったって、びくともするもんか。",
   "wait": 2400
  },
  {
   "type": "narr",
   "text": "おれだって人間だ、いくら下手だって糸さえ卸しゃ、何かかかるだろう、",
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "ここでおれが行かないと、赤シャツの事だから、下手だから行かないんだ、嫌いだから行かないんじゃないと邪推するに相違ない。",
   "wait": 3240
  },
  {
   "type": "narr",
   "text": "おれはこう考えたから、",
   "wait": 4940
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "行きましょう",
   "dur": 2280,
   "wait": 1820
  },
  {
   "type": "narr",
   "text": "と答えた。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "それから、学校をしまって、一応うちへ帰って、支度を整えて、",
   "wait": 1420
  },
  {
   "type": "narr",
   "text": "停車場で赤シャツと野だを待ち合せて浜へ行った。",
   "wait": 2980
  },
  {
   "type": "fx",
   "fx": "fadeout",
   "dur": 900,
   "wait": 2600
  },
  {
   "type": "fx",
   "fx": "bg",
   "bg": "sea",
   "sky": "day",
   "scroll": 0,
   "dur": 0,
   "wait": 1000
  },
  {
   "type": "fx",
   "fx": "fadein",
   "dur": 1000,
   "wait": 100
  },
  {
   "type": "narr",
   "text": "船頭は一人で、船は細長い東京辺では見た事もない恰好である。",
   "wait": 300
  },
  {
   "type": "narr",
   "text": "さっきから船中見渡すが釣竿が一本も見えない。",
   "wait": 2980
  },
  {
   "type": "narr",
   "text": "釣竿なしで釣が出来るものか、どうする了見だろうと、野だに聞くと、",
   "wait": 2530
  },
  {
   "type": "say",
   "who": "野だいこ",
   "text": "沖釣には竿は用いません、糸だけでげす",
   "dur": 3840,
   "wait": 3180
  },
  {
   "type": "narr",
   "text": "と顋を撫でて黒人じみた事を云った。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "こう遣り込められるくらいならだまっていればよかった。",
   "wait": 2200
  },
  {
   "type": "narr",
   "text": "船頭はゆっくりゆっくり漕いでいるが熟練は恐しいもので、",
   "wait": 2790
  },
  {
   "type": "narr",
   "text": "見返えると、浜が小さく見えるくらいもう出ている。",
   "wait": 2860
  },
  {
   "type": "narr",
   "text": "高柏寺の五重の塔が森の上へ抜け出して針のように尖がってる。",
   "wait": 2660
  },
  {
   "type": "narr",
   "text": "向側を見ると青嶋が浮いている。これは人の住まない島だそうだ。",
   "wait": 2980
  },
  {
   "type": "narr",
   "text": "よく見ると石と松ばかりだ。なるほど石と松ばかりじゃ住めっこない。",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "赤シャツは、しきりに眺望していい景色だと云ってる。",
   "wait": 3180
  },
  {
   "type": "narr",
   "text": "野だは絶景でげすと云ってる。",
   "wait": 2720
  },
  {
   "type": "narr",
   "text": "絶景だか何だか知らないが、いい心持ちには相違ない。",
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "ひろびろとした海の上で、潮風に吹かれるのは薬だと思った。",
   "wait": 2720
  },
  {
   "type": "narr",
   "text": "いやに腹が減る。",
   "wait": 2920
  },
  {
   "type": "fx",
   "fx": "fadeout",
   "dur": 2000,
   "wait": 1620
  },
