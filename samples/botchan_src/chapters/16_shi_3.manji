  {
   "type": "caption",
   "text": "四（その三）",
   "dur": 3200,
   "wait": 300
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「なんでバッタなんか、おれの床の中へ入れた」",
   "dur": 4360,
   "wait": 600
  },
  {
   "type": "say",
   "who": "生徒",
   "text": "「バッタた何ぞな」",
   "dur": 2670,
   "wait": 3840
  },
  {
   "type": "narr",
   "text": "と真先の一人がいった。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "やに落ち付いていやがる。",
   "wait": 1820
  },
  {
   "type": "narr",
   "text": "この学校じゃ校長ばかりじゃない、生徒まで曲りくねった言葉を使うんだろう。",
   "wait": 1880
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「バッタを知らないのか、知らなけりゃ見せてやろう」",
   "dur": 4750,
   "wait": 3440
  },
  {
   "type": "narr",
   "text": "と云ったが、生憎掃き出してしまって一匹も居ない。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "また小使を呼んで、",
   "wait": 2660
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「さっきのバッタを持ってこい」",
   "dur": 3450,
   "wait": 1680
  },
  {
   "type": "narr",
   "text": "と云ったら、",
   "wait": 0
  },
  {
   "type": "say",
   "who": "小使",
   "text": "「もう掃溜へ棄ててしまいましたが、拾って参りましょうか」",
   "dur": 5140,
   "wait": 1490
  },
  {
   "type": "narr",
   "text": "と聞いた。",
   "wait": 0
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「うんすぐ拾って来い」",
   "dur": 2930,
   "wait": 1420
  },
  {
   "type": "narr",
   "text": "と云うと小使は急いで馳け出したが、やがて半紙の上へ十匹ばかり載せて来て",
   "wait": 0
  },
  {
   "type": "say",
   "who": "小使",
   "text": "「どうもお気の毒ですが、生憎夜でこれだけしか見当りません。あしたになりましたらもっと拾って参ります」",
   "dur": 7000,
   "wait": 3380
  },
  {
   "type": "narr",
   "text": "と云う。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "小使まで馬鹿だ。",
   "wait": 1360
  },
  {
   "type": "narr",
   "text": "おれはバッタの一つを生徒に見せて",
   "wait": 1620
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「バッタたこれだ、大きなずう体をして、バッタを知らないた、何の事だ」",
   "dur": 5920,
   "wait": 2140
  },
  {
   "type": "narr",
   "text": "と云うと、一番左の方に居た顔の丸い奴が",
   "wait": 0
  },
  {
   "type": "say",
   "who": "生徒",
   "text": "「そりゃ、イナゴぞな、もし」",
   "dur": 3320,
   "wait": 2340
  },
  {
   "type": "narr",
   "text": "と生意気におれを遣り込めた。",
   "wait": 0
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「篦棒め、イナゴもバッタも同じもんだ。第一先生を捕まえてなもした何だ。菜飯は田楽の時より外に食うもんじゃない」",
   "dur": 7000,
   "wait": 2010
  },
  {
   "type": "narr",
   "text": "とあべこべに遣り込めてやったら",
   "wait": 0
  },
  {
   "type": "say",
   "who": "生徒",
   "text": "「なもしと菜飯とは違うぞな、もし」",
   "dur": 3710,
   "wait": 2080
  },
  {
   "type": "narr",
   "text": "と云った。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "いつまで行ってもなもしを使う奴だ。",
   "wait": 1420
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「イナゴでもバッタでも、何でおれの床の中へ入れたんだ。おれがいつ、バッタを入れてくれと頼んだ」",
   "dur": 7000,
   "wait": 2200
  },
  {
   "type": "say",
   "who": "生徒",
   "text": "「誰も入れやせんがな」",
   "dur": 2930,
   "wait": 6840
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「入れないものが、どうして床の中に居るんだ」",
   "dur": 4360,
   "wait": 2520
  },
  {
   "type": "say",
   "who": "生徒",
   "text": "「イナゴは温い所が好きじゃけれ、大方一人でおはいりたのじゃあろ」",
   "dur": 5660,
   "wait": 3840
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「馬鹿あ云え。バッタが一人でおはいりになるなんて――バッタにおはいりになられてたまるもんか。――さあなぜこんないたずらをしたか、云え」",
   "dur": 7000,
   "wait": 5040
  },
  {
   "type": "say",
   "who": "生徒",
   "text": "「云えてて、入れんものを説明しようがないがな」",
   "dur": 4490,
   "wait": 9240
  },
  {
   "type": "narr",
   "text": "けちな奴等だ。",
   "wait": 3960
  },
  {
   "type": "narr",
   "text": "自分で自分のした事が云えないくらいなら、てんでしないがいい。",
   "wait": 1560
  },
  {
   "type": "narr",
   "text": "証拠さえ挙がらなければ、しらを切るつもりで図太く構えていやがる。",
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "おれだって中学に居た時分は少しはいたずらもしたもんだ。",
   "wait": 3180
  },
  {
   "type": "narr",
   "text": "しかしだれがしたと聞かれた時に、尻込みをするような卑怯な事はただの一度もなかった。",
   "wait": 2860
  },
  {
   "type": "narr",
   "text": "したものはしたので、しないものはしないに極ってる。",
   "wait": 3760
  },
  {
   "type": "narr",
   "text": "おれなんぞは、いくら、いたずらをしたって潔白なものだ。",
   "wait": 2720
  },
  {
   "type": "narr",
   "text": "嘘を吐いて罰を逃げるくらいなら、始めからいたずらなんかやるものか。",
   "wait": 2860
  },
  {
   "type": "narr",
   "text": "いたずらと罰はつきもんだ。",
   "wait": 3240
  },
  {
   "type": "narr",
   "text": "罰があるからいたずらも心持ちよく出来る。",
   "wait": 1940
  },
  {
   "type": "narr",
   "text": "いたずらだけで罰はご免蒙るなんて下劣な根性がどこの国に流行ると思ってるんだ。",
   "wait": 2400
  },
  {
   "type": "narr",
   "text": "金は借りるが、返す事はご免だと云う連中はみんな、こんな奴等が卒業してやる仕事に相違ない。",
   "wait": 3570
  },
  {
   "type": "narr",
   "text": "全体中学校へ何しにはいってるんだ。",
   "wait": 3960
  },
  {
   "type": "narr",
   "text": "学校へはいって、嘘を吐いて、胡魔化して、陰でこせこせ生意気な悪いたずらをして、",
   "wait": 2200
  },
  {
   "type": "narr",
   "text": "そうして大きな面で卒業すれば教育を受けたもんだと癇違いをしていやがる。",
   "wait": 3640
  },
  {
   "type": "narr",
   "text": "話せない雑兵だ。",
   "wait": 3380
  },
  {
   "type": "narr",
   "text": "おれはこんな腐った了見の奴等と談判するのは胸糞が悪るいから、",
   "wait": 1620
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "「そんなに云われなきゃ、聞かなくっていい。中学校へはいって、上品も下品も区別が出来ないのは気の毒なものだ」",
   "dur": 7000,
   "wait": 3050
  },
  {
   "type": "narr",
   "text": "と云って六人を逐っ放してやった。",
   "wait": 0
  },
  {
   "type": "narr",
   "text": "おれは言葉や様子こそあまり上品じゃないが、心はこいつらよりも遥かに上品なつもりだ。",
   "wait": 2140
  },
  {
   "type": "narr",
   "text": "六人は悠々と引き揚げた。",
   "wait": 3760
  },
  {
   "type": "narr",
   "text": "上部だけは教師のおれよりよっぽどえらく見える。",
   "wait": 1880
  },
  {
   "type": "narr",
   "text": "実は落ち付いているだけなお悪るい。",
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "おれには到底これほどの度胸はない。",
   "wait": 2200
  },
  {
   "type": "fx",
   "fx": "fadeout",
   "dur": 2000,
   "wait": 2200
  },
