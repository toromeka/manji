   "text": "とまた山嵐が聞いた。",
   "wait": 0
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "うん",
   "dur": 2000,
   "wait": 1750
  },
  {
   "type": "narr",
   "text": "と云ったが、うんだけでは気が済まなかったから、",
   "wait": 0
  },
  {
   "type": "say",
   "who": "おれ",
   "text": "この学校の生徒は分らずやだな",
   "dur": 3320,
   "wait": 2600
  },
  {
   "type": "narr",
   "text": "と云ってやった。",
   "wait": 0
  },
