   "size": 13,
   "se": "wind",
   "drift": "leave",
   "dur": 2400,
   "wait": 1800
  },
  {
   "type": "say",
   "text": "「おう、親方。そば、できるかい？」",
   "who": "客",
   "speaker": "right",
   "pos": "kyaku",
   "size": 19,
   "wait": 3800,
   "dur": 3300
  },
  {
   "type": "say",
   "text": "「へえ、いらっしゃい。できますよ」",
   "who": "親方",
   "speaker": "left",
   "pos": "oyakata",
   "size": 18,
   "wait": 2900,
   "dur": 3000
  },
  {
   "type": "say",
   "text": "「そうかい、じゃあ一杯こしらえてくんな。寒い夜には、あつあつのそばに限るね」",
   "who": "客",
   "speaker": "right",
   "pos": "kyaku",
   "size": 18,
   "wait": 3000,
   "dur": 5600
  },
  {
