  {
   "type": "say",
   "who": "丸山",
   "text": "はいどうもー！　こたつみかんです！",
   "dur": 3270,
   "wait": 650
  },
  {
   "type": "say",
   "who": "角田",
   "text": "よろしくお願いしますー！",
   "dur": 2720,
   "wait": 2095,
   "eff": "pop"
  },
  {
   "type": "fx",
   "fx": "bgm",
   "preset": "none",
   "wait": 1220
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "いきなりやけど角田くん、ぼく今朝ね、ホットケーキ食べてん。",
   "dur": 4590,
   "wait": 1670
  },
  {
   "type": "say",
   "who": "角田",
   "text": "ええやん。朝からホットケーキ、しゃれてるなあ。",
   "dur": 3930,
   "wait": 3115
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "ほんで母親に「朝ごはんちゃんと食べた？」って聞かれて「食べたで」言うたら、「それはおやつや」言われてん。",
   "dur": 7120,
   "wait": 2605
  },
  {
   "type": "say",
   "who": "角田",
   "text": "あー、そこ揉めるとこやね。",
   "dur": 2830,
   "wait": 5070
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "せやから今日は、ホットケーキが朝ごはんかおやつか、ここではっきりさせたいねん。",
   "dur": 5690,
   "wait": 1755
  },
  {
   "type": "say",
   "who": "角田",
   "text": "ええよ。ほな今から「朝ごはん裁判」開廷します！",
   "dur": 3930,
   "wait": 3965,
   "eff": "pop"
  },
  {
   "type": "se",
   "text": "カンカン！",
   "se": "pon",
   "pos": "seC",
   "dur": 1000,
   "wait": 2155
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "裁判長おるの？",
   "dur": 2170,
   "wait": 650
  },
  {
   "type": "say",
   "who": "角田",
   "text": "ぼくが裁判長兼ツッコミや。",
   "dur": 2830,
   "wait": 1245
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "兼任すな、公平さが心配や。",
   "dur": 2830,
   "wait": 1755
  },
  {
   "type": "say",
   "who": "角田",
   "text": "まず第一の基準。食べた時間は何時や？",
   "dur": 3380,
   "wait": 1755
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "朝の七時。",
   "dur": 1950,
   "wait": 2180
  },
  {
   "type": "say",
   "who": "角田",
   "text": "七時は朝ごはんの時間やね。ここは朝ごはん側に一点。",
   "dur": 4150,
   "wait": 1075
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "よっしゃ！　ほらな！",
   "dur": 2500,
   "wait": 2775
  },
  {
   "type": "say",
   "who": "角田",
   "text": "第二の基準。上に何をのせた？",
   "dur": 2940,
   "wait": 1500
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "バターとはちみつと、ホイップクリームと、いちごと、チョコソースと、カラースプレー。",
   "dur": 5910,
   "wait": 1840
  },
  {
   "type": "say",
   "who": "角田",
   "text": "のせすぎや！　パフェの土台やないか！",
   "dur": 3380,
   "wait": 4135,
   "eff": "pop"
  },
  {
   "type": "se",
   "text": "ペシッ",
   "se": "tsukkomi",
   "pos": "seR",
   "dur": 900,
   "wait": 0
  },
  {
   "type": "say",
   "who": "角田",
   "text": "それはもう完全におやつ側や。一対一。",
   "dur": 3380,
   "wait": 650
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "待って、いちごは果物やから朝ごはん側にならへん？",
   "dur": 4040,
   "wait": 2180
  },
  {
   "type": "say",
   "who": "角田",
   "text": "いちご一粒でカラースプレー帳消しにできるかい！",
   "dur": 3930,
   "wait": 2690,
   "eff": "pop"
  },
  {
   "type": "say",
   "who": "角田",
   "text": "第三の基準。一緒に何を飲んだ？",
   "dur": 3050,
   "wait": 2605
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "味噌汁。",
   "dur": 1840,
   "wait": 1925
  },
  {
   "type": "say",
   "who": "角田",
   "text": "味噌汁！？　ホットケーキに！？",
   "dur": 3050,
   "wait": 990
  },
  {
   "type": "se",
   "text": "ボヨーン",
   "se": "boing",
   "pos": "seC",
   "dur": 1000,
   "wait": 0
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "あったかい汁物があると、ちゃんとした朝ごはんって気がするやん。",
   "dur": 4810,
   "wait": 650
  },
  {
   "type": "say",
   "who": "角田",
   "text": "気がするだけや！　組み合わせがもう事件や！",
   "dur": 3710,
   "wait": 3285,
   "eff": "pop"
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "でも基準的には、味噌汁は朝ごはん側やろ？",
   "dur": 3600,
   "wait": 2435
  },
  {
   "type": "say",
   "who": "角田",
   "text": "……くやしいけど味噌汁はめちゃくちゃ朝ごはん側や。二対一。",
   "dur": 4590,
   "wait": 2350
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "勝っとるやん！",
   "dur": 2170,
   "wait": 3115
  },
  {
   "type": "say",
   "who": "角田",
   "text": "第四の基準。食べ終わったあと、どんな気分になった？",
   "dur": 4150,
   "wait": 1245
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "「よし、今日も一日がんばろう」……の前に、ちょっと昼寝したなった。",
   "dur": 5030,
   "wait": 2775
  },
  {
   "type": "say",
   "who": "角田",
   "text": "おやつや！　満足して寝たなるのはおやつの特徴や！　二対二！",
   "dur": 4590,
   "wait": 3455,
   "eff": "pop"
  },
  {
   "type": "se",
   "text": "ペシッ",
   "se": "tsukkomi",
   "pos": "seR",
   "dur": 900,
   "wait": 0
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "ほな最終基準いこか。",
   "dur": 2500,
   "wait": 650
  },
  {
   "type": "say",
   "who": "角田",
   "text": "なんで被告が仕切んねん。……第五の基準。それを誰と食べた？",
   "dur": 4590,
   "wait": 1500
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "おばあちゃんと。",
   "dur": 2280,
   "wait": 3115
  },
  {
   "type": "say",
   "who": "角田",
   "text": "ええ話っぽくなってきたな。おばあちゃんは何て？",
   "dur": 3930,
   "wait": 1330
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "「朝からホットケーキなんて、おやつみたいでええねえ」って。",
   "dur": 4590,
   "wait": 2605
  },
  {
   "type": "say",
   "who": "角田",
   "text": "おばあちゃん、はっきり「おやつみたい」言うてるやないか！",
   "dur": 4480,
   "wait": 3115,
   "eff": "pop"
  },
  {
   "type": "say",
   "who": "丸山",
   "text": "「みたい」やから、本物のおやつではないってことやん。",
   "dur": 4260,
   "wait": 3030
  },
  {
   "type": "say",
   "who": "角田",
   "text": "屁理屈が上手！　弁護士なれるわ！",
